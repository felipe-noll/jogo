  m_Script: {fileID: 11500000, guid: 8e634f33db038d448b6b819c06e41d99, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 814117552}
  startDelay: 3
  doctorSprite: {fileID: -5277425587287654998, guid: ce3bbf60f9d022448a94967a3617e479, type: 3}
  playerSprite: {fileID: 3275810401724867860, guid: 11133e430ef2e1a44be2404acc7edccc, type: 3}
  doctorBlip: {fileID: 8300000, guid: 1a5f9ca0f0b95324bbaef537693a0061, type: 3}
  playerBlip: {fileID: 8300000, guid: 72b3401cc0e08634da199b4bea9bbd63, type: 3}
  startDialogueLines:
  - speaker: 0
    text: "Ol\xE1 ajudante! Como hoje \xE9 sua primeira opera\xE7\xE3o, vou te dar algumas dicas! Para come\xE7ar, pule o di\xE1logo apertando E!"
  - speaker: 1
    text: vorp
  - speaker: 0
    text: "Agora, sua primeira ferramenta, aperte 1 para selecionar a broca! Mas cuidado! Use-a apenas nas c\xE1ries!"
  - speaker: 0
    text: "Aperte 2 para equipar sua segunda ferramenta! Ela \xE9 a massa que voc\xEA ir\xE1 usar para cobrir o buraco deixado pela broca!"
  - speaker: 0
    text: "E sua \xFAltima ferramenta, a cureta! Aperte 3 para equip\xE1-la para remover o t\xE1rtaro dos dentes dos pacientes!"
  - speaker: 0
    text: "Al\xE9m disso, quando voc\xEA terminar a limpeza, aperte ENTER para concluir o atendimento!"
  - speaker: 0
    text: "Isso \xE9 tudo que voc\xEA precisa saber, tem alguma d\xFAvida?"
  - speaker: 1
    text: vorp
  - speaker: 0
    text: "\xD3timo! M\xE3os \xE0 obra!"
